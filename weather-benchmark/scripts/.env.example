# --- Connexion PostgreSQL (Supabase) ------------------------------------------
#
# Option A — URL (si le mdp ne contient pas @ # : / ? etc.)
# Si erreur "failed to resolve host 'xxx@db...'" utiliser Option B (mdp special).
#
# DATABASE_URL=postgresql://postgres:MOT_DE_PASSE_SIMPLE@db.REF.supabase.co:5432/postgres?sslmode=require
#
# Option B — recommandée si le mdp contient @ [ ] # etc. (prend le pas sur DATABASE_URL si rempli) :
# Sur une ligne POSTGRES_PASSWORD=..., un # sans guillemets coupe la valeur : utiliser
# POSTGRES_PASSWORD="votre#motDePasse"
POSTGRES_HOST=db.VOTRE_REF.supabase.co
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
#
# DATABASE_URL=...

DATABASE_URL=

# Clés API prévisions (voir collect_forecasts.py) — vide = fournisseur ignoré en local/CI
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=
TOMORROW_IO_API_KEY=
VISUAL_CROSSING_API_KEY=
# Portail Meteo-France officiel (non utilisé par le connecteur actuel)
METEO_FRANCE_API_KEY=
METEO_FRANCE_API_URL=
