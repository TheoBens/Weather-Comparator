# ---------------------------------------------------------------------------
# Option A — comme scripts/.env (recommandé si pooler Supabase, évite les bugs d’URI)
# ---------------------------------------------------------------------------
POSTGRES_HOST=aws-0-VOTRE_REGION.pooler.supabase.com
POSTGRES_USER=postgres.VOTRE_PROJECT_REF
# Obligatoire entre guillemets si le mot de passe contient # ou ;
POSTGRES_PASSWORD="votre_mot_de_passe_db"
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Ne laisse PAS une ancienne ligne DATABASE_URL=postgresql://postgres:... (sans .REF) :
# elle serait encore lue ou confondrait la config → erreur « user postgres » avec le pooler.

# ---------------------------------------------------------------------------
# Option B — URI seule ; sur pooler : user MUST be postgres.REF dans l’URI,
# PAS postgresql://postgres:mdp@...
# ---------------------------------------------------------------------------
# Facultatif : IP(s) depuis lesquelles tu ouvres le dev server (reseau local), separees par des virgules
# ALLOWED_DEV_ORIGINS=10.241.46.135
